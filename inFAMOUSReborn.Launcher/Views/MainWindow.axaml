<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:inFAMOUSReborn.Launcher.ViewModels"
        mc:Ignorable="d" Width="800" Height="600" CanResize="False"
        x:Class="inFAMOUSReborn.Launcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.ico"
        Title="inFAMOUS Reborn Launcher v1.0.2"
        Background="#121212" Foreground="#E0E0E0"
        FontFamily="Helvetica, Arial, sans-serif">

    <Window.Styles>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#555555" />
            <Setter Property="Foreground" Value="#CCCCCC" />
        </Style>
        
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#333333"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#4A4A4A"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#555555"/>
        </Style>
        
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="#252525" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,6,0,0" /> 
        </Style>
        
        <Style Selector="SelectableTextBlock">
            <Setter Property="SelectionBrush" Value="#555555" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, 200">
        
        <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Grid.Row="0" Padding="20">
            <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Text="{Binding CurrentStepText}"/>
                <Border Background="#333333" CornerRadius="4" IsVisible="{Binding IsOptional}" Padding="6,2">
                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="#AAAAAA" Text="OPTIONAL" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>
        
        <Grid Grid.Row="1">
            <StackPanel HorizontalAlignment="Center" Spacing="20" VerticalAlignment="Center">
                <TextBlock FontSize="16" MaxWidth="600" Text="{Binding StepDescription}" TextAlignment="Center" TextWrapping="Wrap"/>
                
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    
                    <Button Background="#FFFFFF" Command="{Binding ExecutePrimaryActionCommand}" Content="{Binding PrimaryButtonText}" CornerRadius="4" FontWeight="Bold" Foreground="#000000" Padding="30,12"/>
                    
                    <Button Background="Transparent" BorderBrush="#888888" BorderThickness="1" Command="{Binding SkipStepCommand}" Content="Skip" CornerRadius="4" FontWeight="Bold" Foreground="#888888" IsVisible="{Binding IsOptional}" Padding="20,12"/>
                    
                    <Button x:Name="SortButton"
                            Content="Sort" 
                            IsVisible="{Binding IsSortMenuVisible}" 
                            Background="#2A2A2A" 
                            Foreground="#FFFFFF" 
                            BorderBrush="#555555" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            FontWeight="Bold" 
                            Padding="15,12">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <ListBox ItemsSource="{Binding SortOptions}" 
                                         SelectedIndex="{Binding SelectedSortIndex}" 
                                         SelectionChanged="SortMenu_SelectionChanged"
                                         Background="Transparent" 
                                         BorderThickness="0" 
                                         Margin="-5"/>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    
                </StackPanel>
                
                <StackPanel HorizontalAlignment="Center" IsVisible="{Binding IsReadmeLinkVisible}" Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock FontSize="12" Foreground="#AAAAAA" Text="Stuck on this step? " VerticalAlignment="Center"/>
                    <Button Classes="link" Background="Transparent" BorderThickness="0" Command="{Binding OpenReadmeCommand}" Content="Refer to the README." Cursor="Hand" FontSize="12" Foreground="#4DA6FF" Padding="0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            
            <TextBlock Text="Made by Adam Stark" Foreground="#444444" FontSize="10" 
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15"/>
        </Grid>
        
        <Border Background="#0A0A0A" BorderBrush="#333333" BorderThickness="0,1,0,0" Grid.Row="2">
            <Grid>
                <ScrollViewer x:Name="TerminalScroll">
                    <SelectableTextBlock FontFamily="Consolas, Monaco, monospace" FontSize="12" Foreground="#AAAAAA" Padding="15" Text="{Binding TerminalOutput}" TextWrapping="Wrap"/>
                </ScrollViewer>
                
                <Button Command="{Binding CopyLogCommand}" Content="Copy" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10" Background="#333333" Foreground="#FFFFFF" Padding="15,6" CornerRadius="4" Cursor="Hand" FontSize="12" FontWeight="Bold" ToolTip.Tip="Copy to clipboard"/>
            </Grid>
        </Border>
        
    </Grid>
</Window>